{
  "displayName": "GCP Capacity & Stockouts: Executive Overview",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "width": 12,
        "height": 2,
        "xPos": 0,
        "yPos": 0,
        "widget": {
          "title": "Fleet Capacity & Stockouts Overview",
          "text": {
            "content": "### GCP Capacity & Stockouts: Executive Roll-Up\nThis dashboard provides unified visibility into resource capacity constraints and stockouts across **Compute Engine (GCE)**, **Google Kubernetes Engine (GKE)**, and **Cloud SQL** within project `${PROJECT_ID}`.\n\n* **Unified Telemetry**: Tracks pool exhaustions (`ZONE_RESOURCE_POOL_EXHAUSTED`), FailedScaleUp events, and database allocation stalls.\n* **Dedicated Views**: For detailed root-cause analysis, refer to the dedicated **GKE**, **GCE**, and **Cloud SQL** capacity dashboards.\n* **Time Window**: Use the time picker in the top right (**1H**, **6H**, **1D**, **7D**) to view live or historical trends.",
            "format": "MARKDOWN"
          }
        }
      },
      {
        "width": 4,
        "height": 4,
        "xPos": 0,
        "yPos": 2,
        "widget": {
          "title": "Stockouts Breakdown by Service",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "legendTemplate": "GKE Stockouts",
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/gke_node_provisioning_stockouts\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA"
                    }
                  }
                }
              },
              {
                "legendTemplate": "GCE Stockouts",
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/gce_instance_stockouts\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA"
                    }
                  }
                }
              },
              {
                "legendTemplate": "Cloud SQL Stockouts",
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/cloudsql_instance_stockouts\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA"
                    }
                  }
                }
              }
            ],
            "yAxis": {
              "label": "Stockout Count",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "width": 4,
        "height": 4,
        "xPos": 4,
        "yPos": 2,
        "widget": {
          "title": "GCE & GKE Stockouts by Zone",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "legendTemplate": "GCE (${metric.labels.zone})",
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/gce_instance_stockouts\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "groupByFields": [
                        "metric.labels.zone"
                      ]
                    }
                  }
                }
              },
              {
                "legendTemplate": "GKE (${resource.labels.zone})",
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/gke_node_provisioning_stockouts\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "groupByFields": [
                        "resource.labels.zone"
                      ]
                    }
                  }
                }
              }
            ],
            "yAxis": {
              "label": "Zone Stockouts",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "width": 4,
        "height": 4,
        "xPos": 8,
        "yPos": 2,
        "widget": {
          "title": "Fleet Provisioning Activity (Successes)",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "legendTemplate": "GKE Nodes Provisioned",
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/gke_node_provisioning_successes\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA"
                    }
                  }
                }
              },
              {
                "legendTemplate": "GCE Instances Created",
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/gce_instance_provisioning_successes\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA"
                    }
                  }
                }
              },
              {
                "legendTemplate": "Cloud SQL Instances Created/Updated",
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/cloudsql_instance_provisioning_successes\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA"
                    }
                  }
                }
              }
            ],
            "yAxis": {
              "label": "Success Count",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "width": 12,
        "height": 4,
        "xPos": 0,
        "yPos": 6,
        "widget": {
          "title": "Comparative Fleet Trend: Universal Stockouts vs Successful Provisionings",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "legendTemplate": "Total Stockouts (GCP Fleet)",
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/gcp_capacity_stockouts\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA"
                    }
                  }
                }
              },
              {
                "legendTemplate": "GKE Nodes Created (${metric.labels.machine_family})",
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/gke_node_provisioning_successes\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "groupByFields": [
                        "metric.labels.machine_family"
                      ]
                    }
                  }
                }
              },
              {
                "legendTemplate": "GCE Instances Created",
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/gce_instance_provisioning_successes\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA"
                    }
                  }
                }
              },
              {
                "legendTemplate": "Cloud SQL Instances Created/Updated",
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/cloudsql_instance_provisioning_successes\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA"
                    }
                  }
                }
              }
            ],
            "yAxis": {
              "label": "Event Count",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "width": 12,
        "height": 8,
        "xPos": 0,
        "yPos": 10,
        "widget": {
          "title": "Details Pane: Raw Stockout & Capacity Exhaustion Logs (GKE, GCE, Cloud SQL)",
          "logsPanel": {
            "filter": "(resource.type=\"k8s_pod\" AND logName : \"events\" AND jsonPayload.reason=\"FailedScaleUp\") OR (logName : \"cloudaudit.googleapis.com%2Factivity\" AND (protoPayload.status.message=\"ZONE_RESOURCE_POOL_EXHAUSTED\" OR protoPayload.status.message=~\"does not have enough resources available\" OR protoPayload.status.details.value.errorInfo.reason=\"stockout\" OR protoPayload.status.details.value.errorInfo.reason=\"ZONE_RESOURCE_POOL_EXHAUSTED\" OR protoPayload.status.message=~\"insufficient capacity\" OR (protoPayload.serviceName=\"cloudsql.googleapis.com\" AND (protoPayload.status.code=111 OR protoPayload.status.code=8))))",
            "resourceNames": [
              "projects/${PROJECT_ID}"
            ]
          }
        }
      }
    ]
  }
}
