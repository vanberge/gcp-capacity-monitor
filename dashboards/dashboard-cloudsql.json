{
  "displayName": "Cloud SQL Capacity: Database Stockouts & Provisioning",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "width": 12,
        "height": 2,
        "xPos": 0,
        "yPos": 0,
        "widget": {
          "title": "Cloud SQL Database Capacity Overview",
          "text": {
            "content": "### Cloud SQL Database Capacity & Stockout Monitoring\nThis dashboard tracks **capacity stockouts** and **successful provisionings** for Cloud SQL instances (PostgreSQL, MySQL, SQL Server) in project `${PROJECT_ID}`.\n\n* **Operations Tracked**: Covers new database creations (`create`), machine tier resizing/scaling (`update`), restarts, and High Availability failovers.\n* **Regional Breakdown**: Highlights which regions or zones are encountering underlying compute hardware exhaustion for database tiers.\n* **Time Window**: Use the time picker in the top right (**1H**, **6H**, **1D**, **7D**) to view live or historical trends.",
            "format": "MARKDOWN"
          }
        }
      },
      {
        "width": 6,
        "height": 4,
        "xPos": 0,
        "yPos": 2,
        "widget": {
          "title": "Cloud SQL Database Stockouts by Region",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "legendTemplate": "Stockouts (${metric.labels.region})",
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/cloudsql_instance_stockouts\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "groupByFields": [
                        "metric.labels.region"
                      ]
                    }
                  }
                }
              }
            ],
            "yAxis": {
              "label": "Stockout Count",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "width": 6,
        "height": 4,
        "xPos": 6,
        "yPos": 2,
        "widget": {
          "title": "Cloud SQL Stockouts by Operation (Create, Update, Failover)",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "legendTemplate": "Operation: ${metric.labels.method}",
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/cloudsql_instance_stockouts\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "groupByFields": [
                        "metric.labels.method"
                      ]
                    }
                  }
                }
              }
            ],
            "yAxis": {
              "label": "Stockout Count",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "width": 6,
        "height": 4,
        "xPos": 0,
        "yPos": 6,
        "widget": {
          "title": "Successful Cloud SQL Provisionings & Resizes by Region",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "legendTemplate": "Created/Updated (${metric.labels.region})",
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/cloudsql_instance_provisioning_successes\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "groupByFields": [
                        "metric.labels.region"
                      ]
                    }
                  }
                }
              }
            ],
            "yAxis": {
              "label": "Instances Created/Updated",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "width": 6,
        "height": 4,
        "xPos": 6,
        "yPos": 6,
        "widget": {
          "title": "Comparative Trend: Cloud SQL Stockouts vs Successes",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "legendTemplate": "Cloud SQL Stockouts",
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/cloudsql_instance_stockouts\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA"
                    }
                  }
                }
              },
              {
                "legendTemplate": "Successful Creations & Resizes",
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/cloudsql_instance_provisioning_successes\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA"
                    }
                  }
                }
              }
            ],
            "yAxis": {
              "label": "Event Count",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "width": 12,
        "height": 8,
        "xPos": 0,
        "yPos": 10,
        "widget": {
          "title": "Details Pane: Raw Cloud SQL Stockout & Allocation Errors",
          "logsPanel": {
            "filter": "resource.type=\"cloudsql_database\" AND logName : \"cloudaudit.googleapis.com%2Factivity\" AND (protoPayload.methodName:\"cloudsql.instances.create\" OR protoPayload.methodName:\"cloudsql.instances.update\" OR protoPayload.methodName:\"cloudsql.instances.restart\" OR protoPayload.methodName:\"cloudsql.instances.failover\" OR protoPayload.methodName:\"cloudsql.instances.clone\") AND severity=\"ERROR\" AND (protoPayload.status.code=111 OR protoPayload.status.code=8 OR protoPayload.status.message=~\"(ZONE_RESOURCE_POOL_EXHAUSTED|resource pool exhausted|insufficient capacity|does not have enough resources available|The zone is currently out of capacity|stockout)\" OR protoPayload.status.details.value.errorInfo.reason=~\"(stockout|ZONE_RESOURCE_POOL_EXHAUSTED)\")",
            "resourceNames": [
              "projects/${PROJECT_ID}"
            ]
          }
        }
      }
    ]
  }
}
